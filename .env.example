# LLM Provider — "gemini" or "openrouter"
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (fallback)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Embedding
EMBEDDING_MODEL=models/text-embedding-004

# Database
DATABASE_URL=sqlite:///./data/evidence_to_action.db

# ChromaDB
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION=enterprise_knowledge

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Ticket connector: mock (SQLite) or jira
CONNECTOR_PROVIDER=mock
CONNECTOR_TIMEOUT_SECONDS=5

# Jira Cloud sandbox (required only when CONNECTOR_PROVIDER=jira)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# Set to 1 only when intentionally running the real Jira sandbox integration test.
JIRA_INTEGRATION=0

# Approval notification provider: mock, slack, or email
APPROVAL_NOTIFIER=mock
# Optional override; otherwise policy/rules.yaml controls escalation timeout.
# APPROVAL_TIMEOUT_SECONDS=300
APPROVAL_PUBLIC_BASE_URL=http://localhost:8000
APPROVAL_LINK_SECRET=

# Slack interactive approvals
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=
APPROVAL_ROLE_SLACK_USERS={}

# Email approvals (signed links are single-use through the pending-approval state)
APPROVAL_ROLE_EMAIL_RECIPIENTS={}
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Analytics savings estimates
ANALYTICS_MINUTES_PER_CASE=15
ANALYTICS_COST_PER_HOUR=50
